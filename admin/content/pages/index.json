  "body": "\n<section class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-grid\">\n      <div>\n        <p class=\"pill\" style=\"margin-bottom:1.25rem\"><span class=\"pill-live\">Live</span> 2,395 releases distributed in the last 24 hours</p>\n        <h1><span class=\"kinetic\" data-kinetic>Published, picked up, and cited by AI.</span></h1>\n        <p class=\"lede\">PressCosmos is the press release distribution platform built for how people actually find news in 2026: search engines, news apps, and AI assistants that answer questions instead of listing links. Send one release and reach journalists, trade desks and answer engines at once.</p>\n        <div class=\"hero-actions\">\n          <a class=\"btn btn-lg\" href=\"submit.html\">Submit a press release <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a>\n          <a class=\"btn btn-ghost btn-lg\" href=\"how-it-works.html\">See how it works</a>\n        </div>\n        <ul class=\"hero-proof\" aria-label=\"Key service facts\">\n          <li class=\"kpi\"><b>42 min</b> median to first pickup</li>\n          <li class=\"kpi\"><b>24</b> languages</li>\n          <li class=\"kpi\"><b>68</b> countries</li>\n          <li class=\"kpi\"><b>9</b> AI engines tracked</li>\n        </ul>\n      </div>\n      <div class=\"orbit-visual\" data-parallax=\"0.035\" role=\"img\" aria-label=\"Illustration of an announcement orbiting through media channels, trade press and AI answer engines\">\n        <div class=\"core\"></div>\n        <div class=\"ring ring-3\"><span class=\"satellite\"></span></div>\n        <div class=\"ring ring-2\"><span class=\"satellite\"></span></div>\n        <div class=\"ring\"><span class=\"satellite\"></span></div>\n        <span class=\"chip chip-a\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3.5 9h17M3.5 15h17\"/><path d=\"M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18\"/></svg> Newswire partners</span>\n        <span class=\"chip chip-b\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"6.5\" y=\"6.5\" width=\"11\" height=\"11\" rx=\"2.2\"/><path d=\"M10 3.5v3M14 3.5v3M10 17.5v3M14 17.5v3M3.5 10h3M3.5 14h3M17.5 10h3M17.5 14h3\"/></svg> AI answer engines</span>\n        <span class=\"chip chip-c\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3M9 21h6\"/></svg> Broadcast desks</span>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section-tight\" aria-label=\"Distribution network\">\n  <div class=\"wrap\">\n    <p class=\"center mono faint\" style=\"margin-bottom:1rem\">Every release can be routed to channels like these</p>\n  </div>\n  \n<div class=\"marquee\" aria-hidden=\"true\">\n  <div class=\"marquee-track\"><span class=\"marquee-item\">Global Financial Newswires</span><span class=\"marquee-item\">Technology & Startup Media</span><span class=\"marquee-item\">Regional Daily Press</span><span class=\"marquee-item\">Trade & Industry Journals</span><span class=\"marquee-item\">Broadcast & Podcast Desks</span><span class=\"marquee-item\">AI Answer Engines</span><span class=\"marquee-item\">News Aggregators</span><span class=\"marquee-item\">Business Journals</span><span class=\"marquee-item\">Healthcare Trade Press</span><span class=\"marquee-item\">Real Estate Journals</span><span class=\"marquee-item\">Higher-Education Media</span><span class=\"marquee-item\">Travel & Hospitality Titles</span><span class=\"marquee-item\">Automotive Trade Media</span><span class=\"marquee-item\">Legal & Compliance Press</span><span class=\"marquee-item\">Retail Sector Analysts</span><span class=\"marquee-item\">Municipal & Civic Desks</span></div><div class=\"marquee-track\"><span class=\"marquee-item\">Global Financial Newswires</span><span class=\"marquee-item\">Technology & Startup Media</span><span class=\"marquee-item\">Regional Daily Press</span><span class=\"marquee-item\">Trade & Industry Journals</span><span class=\"marquee-item\">Broadcast & Podcast Desks</span><span class=\"marquee-item\">AI Answer Engines</span><span class=\"marquee-item\">News Aggregators</span><span class=\"marquee-item\">Business Journals</span><span class=\"marquee-item\">Healthcare Trade Press</span><span class=\"marquee-item\">Real Estate Journals</span><span class=\"marquee-item\">Higher-Education Media</span><span class=\"marquee-item\">Travel & Hospitality Titles</span><span class=\"marquee-item\">Automotive Trade Media</span><span class=\"marquee-item\">Legal & Compliance Press</span><span class=\"marquee-item\">Retail Sector Analysts</span><span class=\"marquee-item\">Municipal & Civic Desks</span></div>\n</div>\n</section>\n\n\n<section class=\"section section-tight\">\n  <div class=\"wrap\">\n    \n    <div class=\"panel panel-glass\" style=\"padding:clamp(1.5rem,4vw,2.75rem);border-radius:var(--r-xl)\">\n    \n<div class=\"stat-row\" data-stagger>\n  <div>\n    <p class=\"stat-value\"><span data-count=\"2400\">0</span><span class=\"gradient-text\">+</span></p>\n    <p class=\"stat-label\">Media destinations</p>\n  </div><div>\n    <p class=\"stat-value\"><span data-count=\"68\">0</span><span class=\"gradient-text\"></span></p>\n    <p class=\"stat-label\">Countries syndicated</p>\n  </div><div>\n    <p class=\"stat-value\"><span data-count=\"42\">0</span><span class=\"gradient-text\">min</span></p>\n    <p class=\"stat-label\">Median time to publish</p>\n  </div><div>\n    <p class=\"stat-value\"><span data-count=\"98\">0</span><span class=\"gradient-text\">%</span></p>\n    <p class=\"stat-label\">Copy approval rate</p>\n  </div>\n</div>\n    <p class=\"mono faint mt-3\">Figures reflect rolling 30-day network averages. <a href=\"analytics.html\" style=\"color:var(--cyan)\">See how we measure this →</a></p>\n  </div>\n  </div>\n</section>\n\n\n<section class=\"section \">\n  <div class=\"wrap\">\n    <div class=\"section-head \" data-reveal>\n      <p class=\"eyebrow\" style=\"margin-bottom:1rem\">Why PressCosmos</p>\n      <h2>Built for the way news is discovered now</h2>\n      <p class=\"lede\">Traditional wires were designed for a world where a release existed on a page and waited to be found. PressCosmos is designed for search results, answer engines and journalists who are already overwhelmed.</p>\n    </div>\n    <div class=\"bento\" data-stagger>\n    <article class=\"card b-2 b-tall spotlight\">\n      <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"6.5\" y=\"6.5\" width=\"11\" height=\"11\" rx=\"2.2\"/><path d=\"M10 3.5v3M14 3.5v3M10 17.5v3M14 17.5v3M3.5 10h3M3.5 14h3M17.5 10h3M17.5 14h3\"/></svg></div>\n      <h3>AI visibility baked into every release</h3>\n      <p>Each announcement ships with structured data, a plain-language summary block, stable canonical URLs and clean semantic HTML — the signals that make a model willing to quote you by name.</p>\n      <ul class=\"ticks\">\n        <li>NewsArticle and Organization schema on every page</li>\n        <li>Answer-engine formatted summary and key points</li>\n        <li>llms.txt guidance and open AI crawler policy</li>\n        <li>Share-of-answer tracking across 9 engines</li>\n      </ul>\n      <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"ai-visibility.html\">Explore the AI Visibility Suite <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n    </article>\n    <article class=\"card b-2 spotlight\">\n      <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 12 19 5\"/><path d=\"M3.6 14.4A9 9 0 1 0 9 3.7\"/><path d=\"M7.2 14.9A4.6 4.6 0 1 0 9.4 8.3\"/><circle cx=\"12\" cy=\"12\" r=\"1.6\"/></svg></div>\n      <h3>Pickup you can actually see</h3>\n      <p>A live map of every outlet that carried the story, plus backlink inventory, sentiment and referral traffic.</p>\n      <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"media-monitoring.html\">Monitoring <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n    </article>\n    <article class=\"card b-2 spotlight\">\n      <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l7.5 3v6c0 4.6-3.1 7.9-7.5 9-4.4-1.1-7.5-4.4-7.5-9V6z\"/><path d=\"m9 12 2.2 2.2L15.5 10\"/></svg></div>\n      <h3>Human editors, not an auto-poster</h3>\n      <p>Every release is reviewed for disclosure, verifiability and newsworthiness before it goes out. 98% approval, usually with improvements.</p>\n      <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"editorial-guidelines.html\">Editorial standards <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n    </article>\n    <article class=\"card b-2 spotlight\">\n      <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M3.5 9h17M3.5 15h17\"/><path d=\"M12 3c2.5 2.6 2.5 15.4 0 18M12 3c-2.5 2.6-2.5 15.4 0 18\"/></svg></div>\n      <h3>Targeting that earns regional pickups</h3>\n      <p>Country, state and metro-level routing combined with vertical targeting lifts regional pickup 30–60% over blanket distribution.</p>\n      <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"distribution.html\">Distribution <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n    </article>\n    <article class=\"card b-4 spotlight\">\n      <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg></div>\n      <h3>Board-ready reporting without the spreadsheet archaeology</h3>\n      <p>Referral traffic, backlink equity, AI citation share and pipeline attribution in one dashboard, exportable as a PDF your CEO will actually read.</p>\n      <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"analytics.html\">Analytics &amp; attribution <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n    </article>\n  </div>\n  </div>\n</section>\n\n\n<section class=\"section section\">\n  <div class=\"wrap\">\n    <div class=\"section-head \" data-reveal>\n      <p class=\"eyebrow\" style=\"margin-bottom:1rem\">Platform</p>\n      <h2>Everything your announcement needs, in one place</h2>\n      <p class=\"lede\">Pick the pieces you need. Most teams start with distribution and add AI visibility and monitoring in the same campaign.</p>\n    </div>\n    <div class=\"card-grid\">\n<article class=\"card spotlight\" data-reveal>\n  \n  <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4.5 12.5 20 4l-6.2 16-2.4-6.1z\"/></svg></div>\n  <h3>Newswire Distribution</h3>\n  <p>Tiered newswire delivery to 2,400+ media destinations, trade desks and aggregators, with translation, targeting and pickup reporting.</p>\n  \n  <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"distribution.html\">Explore <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n</article>\n<article class=\"card spotlight\" data-reveal>\n  \n  <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3v4M12 17v4M3 12h4M17 12h4M6.3 6.3l2.4 2.4M15.3 15.3l2.4 2.4M17.7 6.3l-2.4 2.4M8.7 15.3l-2.4 2.4\"/></svg></div>\n  <h3>AI Visibility Suite</h3>\n  <p>AEO, GEO and LLMO engineering so your announcement is quotable by ChatGPT, Claude, Gemini, Perplexity and AI Overviews — not just indexed by search.</p>\n  \n  <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"ai-visibility.html\">Explore <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n</article>\n<article class=\"card spotlight\" data-reveal>\n  \n  <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 12 19 5\"/><path d=\"M3.6 14.4A9 9 0 1 0 9 3.7\"/><path d=\"M7.2 14.9A4.6 4.6 0 1 0 9.4 8.3\"/><circle cx=\"12\" cy=\"12\" r=\"1.6\"/></svg></div>\n  <h3>Media Monitoring</h3>\n  <p>Real-time pickup tracking across 180,000+ sources with sentiment scoring, journalist alerts and competitive share-of-voice.</p>\n  \n  <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"media-monitoring.html\">Explore <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n</article>\n<article class=\"card spotlight\" data-reveal>\n  \n  <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20V10M10 20V4M16 20v-7M22 20H2\"/></svg></div>\n  <h3>Analytics & Attribution</h3>\n  <p>Prove PR impact with referral traffic, backlink quality, AI citation share and revenue attribution in one dashboard.</p>\n  \n  <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"analytics.html\">Explore <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n</article>\n<article class=\"card spotlight\" data-reveal>\n  \n  <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 21V6a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v15\"/><path d=\"M15 11h3a2 2 0 0 1 2 2v8\"/><path d=\"M8 8h3M8 12h3M8 16h3M2 21h20\"/></svg></div>\n  <h3>Branded Newsroom</h3>\n  <p>A hosted, indexable newsroom on your own domain so every announcement compounds authority instead of scattering across the web.</p>\n  \n  <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"newsroom-hosting.html\">Explore <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n</article>\n<article class=\"card spotlight\" data-reveal>\n  \n  <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-3.6-3.6\"/></svg></div>\n  <h3>SEO PR</h3>\n  <p>Keyword-mapped headlines, entity-rich body copy and contextual backlinks that earn rankings without reading like advertising.</p>\n  \n  <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"seo-pr.html\">Explore <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n</article>\n<article class=\"card spotlight\" data-reveal>\n  \n  <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l7.5 3v6c0 4.6-3.1 7.9-7.5 9-4.4-1.1-7.5-4.4-7.5-9V6z\"/><path d=\"m9 12 2.2 2.2L15.5 10\"/></svg></div>\n  <h3>Crisis Communications</h3>\n  <p>Rapid-response statement distribution with 24/7 standby editors, holding statements and coordinated regional rollout.</p>\n  \n  <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"crisis-communications.html\">Explore <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n</article>\n<article class=\"card spotlight\" data-reveal>\n  \n  <div class=\"card-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 17.5 9 11l4 4 8-8.5\"/><path d=\"M21 6.5v5h-5\"/></svg></div>\n  <h3>Investor Relations</h3>\n  <p>Regulation-aware earnings, funding and material-news distribution built for analyst desks and financial data terminals.</p>\n  \n  <p style=\"margin-top:1.25rem\"><a class=\"link-arrow\" href=\"investor-relations.html\">Explore <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n</article></div>\n  </div>\n</section>\n\n\n<section class=\"section \">\n  <div class=\"wrap\">\n    <div class=\"section-head \" data-reveal>\n      <p class=\"eyebrow\" style=\"margin-bottom:1rem\">The difference</p>\n      <h2>Getting published is step one. Being repeated is the point.</h2>\n      \n    </div>\n    <div class=\"split\">\n    <div class=\"stack\" data-reveal style=\"--flow:1.15rem\">\n      <p class=\"lede\">A press release that nobody reads is a PDF with a press release at the top. PressCosmos optimises the four things that decide whether your announcement travels:</p>\n      <ul class=\"list-check\"><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span><strong>Retrievability</strong> — clean HTML, canonical URLs, a sitemap and an open crawler policy so machines can read you.</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span><strong>Answerability</strong> — a direct answer to the reader's obvious question in the first 60 words, so an assistant has something quotable.</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span><strong>Attribution</strong> — your organisation named consistently as an entity, with a structured knowledge signal behind it.</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span><strong>Corroboration</strong> — syndication across independent outlets, which is still the strongest signal that a claim is worth repeating.</span></li></ul>\n      <p><a class=\"link-arrow\" href=\"compare.html\">Compare PressCosmos with other wires <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n    </div>\n    <div class=\"panel panel-glass\" style=\"padding:clamp(1.25rem,3vw,2rem)\" data-reveal=\"right\">\n      <p class=\"eyebrow\" style=\"margin-bottom:1rem\">Example answer block</p>\n      <div class=\"callout callout-answer\">\n        <strong>What does PressCosmos do?</strong>\n        PressCosmos distributes press releases to 2,400+ media destinations and formats each one for AI answer engines. Releases cost from $149 with no subscription, go live in a median of 42 minutes, and include a pickup, backlink and AI citation report.\n      </div>\n      <p class=\"mono faint mt-3\">This structure — short question, complete answer, named entity, specific numbers — is what gets lifted into AI answers.</p>\n    </div>\n  </div>\n  </div>\n</section>\n\n\n<section class=\"section \">\n  <div class=\"wrap\">\n    <div class=\"section-head \" data-reveal>\n      <p class=\"eyebrow\" style=\"margin-bottom:1rem\">How it works</p>\n      <h2>Four steps from draft to distribution report</h2>\n      \n    </div>\n    <ol class=\"grid g-4\" data-stagger>\n    <li class=\"card spotlight\">\n      <p class=\"mono gradient-text\" style=\"font-size:var(--step-2);font-weight:700\">1</p>\n      <h3 style=\"margin-top:.5rem\">Draft or upload</h3>\n      <p>Write in our editor or paste an existing release. AI drafting is available but never required.</p>\n    </li><li class=\"card spotlight\">\n      <p class=\"mono gradient-text\" style=\"font-size:var(--step-2);font-weight:700\">2</p>\n      <h3 style=\"margin-top:.5rem\">Editorial review</h3>\n      <p>A human editor checks disclosure, claims and formatting, then approves — usually within an hour.</p>\n    </li><li class=\"card spotlight\">\n      <p class=\"mono gradient-text\" style=\"font-size:var(--step-2);font-weight:700\">3</p>\n      <h3 style=\"margin-top:.5rem\">Distribute</h3>\n      <p>Route by tier, industry, country and metro. Translation and multimedia attach here.</p>\n    </li><li class=\"card spotlight\">\n      <p class=\"mono gradient-text\" style=\"font-size:var(--step-2);font-weight:700\">4</p>\n      <h3 style=\"margin-top:.5rem\">Measure and repeat</h3>\n      <p>Watch the pickup map, backlinks and AI citations, then reuse what worked.</p>\n    </li>\n  </ol>\n  <div class=\"hero-actions\"><a class=\"btn btn-ghost\" href=\"how-it-works.html\">See the full process <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></div>\n  </div>\n</section>\n\n\n<section class=\"section \">\n  <div class=\"wrap\">\n    <div class=\"section-head \" data-reveal>\n      <p class=\"eyebrow\" style=\"margin-bottom:1rem\">Industries</p>\n      <h2>Distribution tuned to your sector</h2>\n      <p class=\"lede\">Relevance beats volume. Each industry route carries its own media list, keyword guidance and reviewer specialism.</p>\n    </div>\n    <div class=\"grid g-4\">\n    <a class=\"card spotlight\" href=\"technology.html\" data-reveal>\n      <h3 style=\"font-size:var(--step-0)\">Technology</h3>\n      <p style=\"font-size:var(--step--1)\">11,400+ tech desks and newsletters in network</p>\n    </a><a class=\"card spotlight\" href=\"saas.html\" data-reveal>\n      <h3 style=\"font-size:var(--step-0)\">SaaS & B2B Software</h3>\n      <p style=\"font-size:var(--step--1)\">3,900+ B2B review sites and analyst blogs in network</p>\n    </a><a class=\"card spotlight\" href=\"finance.html\" data-reveal>\n      <h3 style=\"font-size:var(--step-0)\">Finance & Banking</h3>\n      <p style=\"font-size:var(--step--1)\">Terminal and analyst-desk delivery across 41 markets</p>\n    </a><a class=\"card spotlight\" href=\"crypto-web3.html\" data-reveal>\n      <h3 style=\"font-size:var(--step-0)\">Crypto & Web3</h3>\n      <p style=\"font-size:var(--step--1)\">480+ crypto-native outlets and market-data feeds</p>\n    </a><a class=\"card spotlight\" href=\"healthcare.html\" data-reveal>\n      <h3 style=\"font-size:var(--step-0)\">Healthcare & Life Sciences</h3>\n      <p style=\"font-size:var(--step--1)\">2,100+ clinical, pharma and health-policy outlets</p>\n    </a><a class=\"card spotlight\" href=\"real-estate.html\" data-reveal>\n      <h3 style=\"font-size:var(--step-0)\">Real Estate & Property</h3>\n      <p style=\"font-size:var(--step--1)\">Metro and regional property desks in 900+ cities</p>\n    </a><a class=\"card spotlight\" href=\"education.html\" data-reveal>\n      <h3 style=\"font-size:var(--step-0)\">Education & EdTech</h3>\n      <p style=\"font-size:var(--step--1)\">1,700+ higher-education and edtech publications</p>\n    </a><a class=\"card spotlight\" href=\"travel-hospitality.html\" data-reveal>\n      <h3 style=\"font-size:var(--step-0)\">Travel & Hospitality</h3>\n      <p style=\"font-size:var(--step--1)\">1,250+ travel trade and consumer titles</p>\n    </a>\n  </div>\n  <div class=\"hero-actions\"><a class=\"btn btn-ghost\" href=\"industries.html\">All industries <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></div>\n  </div>\n</section>\n\n\n<section class=\"section \">\n  <div class=\"wrap\">\n    <div class=\"section-head \" data-reveal>\n      <p class=\"eyebrow\" style=\"margin-bottom:1rem\">Pricing</p>\n      <h2>Pay per release. No seats, no annual lock-in.</h2>\n      <p class=\"lede\">Every plan includes editorial review, a permanent hosted release page and pickup reporting.</p>\n    </div>\n    <div class=\"plan-grid\">\n<article class=\"card plan spotlight\" data-reveal>\n  \n  <h3>Launch</h3>\n  <p style=\"font-size:var(--step--1)\">For a single announcement that needs to land properly.</p>\n  <p class=\"plan-price\"><span class=\"amount gradient-text\">$149</span><span class=\"unit\">per release</span></p>\n  <ul><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Tier 2 regional + trade distribution</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>AI answer-engine formatting (AEO/GEO/LLMO)</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>1 image or video embed</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Basic pickup report</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Editorial review in 4 business hours</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Permanent hosted release page</span></li></ul>\n  <a class=\"btn btn-ghost btn-block\" href=\"submit.html?plan=launch\">Start with Launch</a>\n</article>\n<article class=\"card plan spotlight is-popular\" data-reveal>\n  <span class=\"plan-badge\">Most popular</span>\n  <h3>Amplify</h3>\n  <p style=\"font-size:var(--step--1)\">The plan most teams run for a full announcement cycle.</p>\n  <p class=\"plan-price\"><span class=\"amount gradient-text\">$349</span><span class=\"unit\">per release</span></p>\n  <ul><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Tier 1 national + international distribution</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Full AI Visibility Suite with share-of-answer tracking</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Unlimited multimedia and PDF media kit</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>24-language translation credits (3 languages)</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Live pickup map, sentiment and backlink report</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Priority editorial review in 60 minutes</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Dedicated account manager</span></li></ul>\n  <a class=\"btn  btn-block\" href=\"submit.html?plan=amplify\">Start with Amplify</a>\n</article>\n<article class=\"card plan spotlight\" data-reveal>\n  \n  <h3>Newsmaker</h3>\n  <p style=\"font-size:var(--step--1)\">Maximum reach for material news, launches and funding rounds.</p>\n  <p class=\"plan-price\"><span class=\"amount gradient-text\">$899</span><span class=\"unit\">per release</span></p>\n  <ul><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Everything in Amplify</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Terminal, analyst-desk and broadcast wire delivery</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Guaranteed top-tier placement lanes</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>10-language syndication bundle</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Journalist outreach and pitch drafting</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Real-time monitoring alerts and crisis lane access</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Same-day strategy session with a PR lead</span></li></ul>\n  <a class=\"btn btn-ghost btn-block\" href=\"submit.html?plan=newsmaker\">Start with Newsmaker</a>\n</article>\n<article class=\"card plan spotlight\" data-reveal>\n  \n  <h3>Studio</h3>\n  <p style=\"font-size:var(--step--1)\">Ongoing newsroom operations for teams shipping news weekly.</p>\n  <p class=\"plan-price\"><span class=\"amount gradient-text\">$1,990</span><span class=\"unit\">per month</span></p>\n  <ul><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Up to 12 releases per month</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Branded custom newsroom on your domain</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Dedicated editorial and SEO strategist</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Quarterly share-of-answer and AI citation audit</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Agency multi-client workspace</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>API access and Zapier automation</span></li><li><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-10\"/></svg><span>Priority crisis lane, 24/7 standby</span></li></ul>\n  <a class=\"btn btn-ghost btn-block\" href=\"submit.html?plan=studio\">Start with Studio</a>\n</article></div>\n  <p class=\"center muted mt-3\" style=\"font-size:var(--step--1)\">Agency and volume pricing starts 22% below list. <a class=\"link-arrow\" href=\"contact.html\">Request a workspace quote <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n  </div>\n</section>\n\n\n<section class=\"section \">\n  <div class=\"wrap\">\n    <div class=\"section-head \" data-reveal>\n      <p class=\"eyebrow\" style=\"margin-bottom:1rem\">Customers</p>\n      <h2>What teams say after switching</h2>\n      \n    </div>\n    <div class=\"card-grid\">\n<figure class=\"card spotlight quote-card\" data-reveal>\n  <div style=\"color:var(--violet);width:26px\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M9.5 6C6.9 7.4 5.4 9.6 5.4 12.4c0 3 1.7 4.9 4 4.9 2 0 3.4-1.4 3.4-3.3 0-1.9-1.3-3.2-3.1-3.2h-.5c.2-1.3 1.2-2.4 2.6-3.2zM19 6c-2.6 1.4-4.1 3.6-4.1 6.4 0 3 1.7 4.9 4 4.9 2 0 3.4-1.4 3.4-3.3 0-1.9-1.3-3.2-3.1-3.2h-.5c.2-1.3 1.2-2.4 2.6-3.2z\"/></svg></div>\n  <blockquote class=\"quote-text\">We ran the same funding announcement through two wires. PressCosmos got us quoted inside AI answers within 48 hours, which the other service never did.</blockquote>\n  <figcaption class=\"quote-foot\">\n    <span class=\"avatar\" aria-hidden=\"true\">PR</span>\n    <span><strong style=\"display:block;font-size:var(--step--1)\">Priya Raghunathan</strong><span class=\"muted\" style=\"font-size:var(--step--1)\">Head of Communications, Northwind Robotics</span></span>\n  </figcaption>\n</figure>\n<figure class=\"card spotlight quote-card\" data-reveal>\n  <div style=\"color:var(--violet);width:26px\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M9.5 6C6.9 7.4 5.4 9.6 5.4 12.4c0 3 1.7 4.9 4 4.9 2 0 3.4-1.4 3.4-3.3 0-1.9-1.3-3.2-3.1-3.2h-.5c.2-1.3 1.2-2.4 2.6-3.2zM19 6c-2.6 1.4-4.1 3.6-4.1 6.4 0 3 1.7 4.9 4 4.9 2 0 3.4-1.4 3.4-3.3 0-1.9-1.3-3.2-3.1-3.2h-.5c.2-1.3 1.2-2.4 2.6-3.2z\"/></svg></div>\n  <blockquote class=\"quote-text\">The pickup map alone changed how we plan launches. We can see which metros actually care before we spend on the next one.</blockquote>\n  <figcaption class=\"quote-foot\">\n    <span class=\"avatar\" aria-hidden=\"true\">DO</span>\n    <span><strong style=\"display:block;font-size:var(--step--1)\">Daniel Okonkwo</strong><span class=\"muted\" style=\"font-size:var(--step--1)\">VP Marketing, Ledgerline Financial</span></span>\n  </figcaption>\n</figure>\n<figure class=\"card spotlight quote-card\" data-reveal>\n  <div style=\"color:var(--violet);width:26px\"><svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\"><path d=\"M9.5 6C6.9 7.4 5.4 9.6 5.4 12.4c0 3 1.7 4.9 4 4.9 2 0 3.4-1.4 3.4-3.3 0-1.9-1.3-3.2-3.1-3.2h-.5c.2-1.3 1.2-2.4 2.6-3.2zM19 6c-2.6 1.4-4.1 3.6-4.1 6.4 0 3 1.7 4.9 4 4.9 2 0 3.4-1.4 3.4-3.3 0-1.9-1.3-3.2-3.1-3.2h-.5c.2-1.3 1.2-2.4 2.6-3.2z\"/></svg></div>\n  <blockquote class=\"quote-text\">Editorial review is fast without being sloppy. They caught a compliance issue our legal team had missed.</blockquote>\n  <figcaption class=\"quote-foot\">\n    <span class=\"avatar\" aria-hidden=\"true\">MA</span>\n    <span><strong style=\"display:block;font-size:var(--step--1)\">Marta Alvés</strong><span class=\"muted\" style=\"font-size:var(--step--1)\">Director of Investor Relations, Halcyon Therapeutics</span></span>\n  </figcaption>\n</figure></div>\n  <p class=\"center mt-3\"><a class=\"link-arrow\" href=\"testimonials.html\">Read more customer reviews <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n  </div>\n</section>\n\n\n<section class=\"section\" id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"split\" style=\"align-items:start\">\n      <div class=\"section-head\" style=\"margin-bottom:0\" data-reveal>\n        <p class=\"eyebrow\" style=\"margin-bottom:1rem\">Answers</p>\n        <h2>Frequently asked questions</h2>\n        <p class=\"lede\">The questions we get asked most by comms teams evaluating us against their current wire.</p>\n        <p class=\"mt-3 muted\" style=\"font-size:var(--step--1)\">Still stuck? <a class=\"link-arrow\" href=\"contact.html\">Talk to a specialist <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h15\"/><path d=\"m13 6 6 6-6 6\"/></svg></a></p>\n      </div>\n      <div class=\"faq-list\" data-accordion=\"single\">\n        <div class=\"faq-item\">\n          <h3 style=\"margin:0\"><button class=\"faq-q\" type=\"button\">What is PressCosmos?<span class=\"icon\" aria-hidden=\"true\"></span></button></h3>\n          <div class=\"faq-a\"><div class=\"faq-a-inner prose\" style=\"font-size:var(--step-0)\">PressCosmos is a press release distribution and AI visibility platform. You write or upload an announcement, our editors review it, and we syndicate it to newswire partners, trade media, regional press and AI answer engines while tracking every pickup, backlink and AI citation you earn.</div></div>\n        </div><div class=\"faq-item\">\n          <h3 style=\"margin:0\"><button class=\"faq-q\" type=\"button\">How is PressCosmos different from a traditional newswire?<span class=\"icon\" aria-hidden=\"true\"></span></button></h3>\n          <div class=\"faq-a\"><div class=\"faq-a-inner prose\" style=\"font-size:var(--step-0)\">Traditional wires optimise for a press release existing on the internet. PressCosmos optimises for your announcement being found, quoted and repeated — by journalists, by search engines and by AI assistants. Every release ships with answer-engine formatting, structured data and entity markup by default.</div></div>\n        </div><div class=\"faq-item\">\n          <h3 style=\"margin:0\"><button class=\"faq-q\" type=\"button\">How long does it take to get published?<span class=\"icon\" aria-hidden=\"true\"></span></button></h3>\n          <div class=\"faq-a\"><div class=\"faq-a-inner prose\" style=\"font-size:var(--step-0)\">Median time from approved submission to first live pickup is 42 minutes on Amplify and Newsmaker plans. Launch plan releases go live within four business hours, and the crisis lane publishes in under 60 minutes at any hour.</div></div>\n        </div><div class=\"faq-item\">\n          <h3 style=\"margin:0\"><button class=\"faq-q\" type=\"button\">Do you review press releases before publishing?<span class=\"icon\" aria-hidden=\"true\"></span></button></h3>\n          <div class=\"faq-a\"><div class=\"faq-a-inner prose\" style=\"font-size:var(--step-0)\">Yes. Every release passes a human editorial review for accuracy, newsworthiness, disclosure requirements and formatting. We approve 98% of submissions, usually with suggested improvements rather than rejections.</div></div>\n        </div><div class=\"faq-item\">\n          <h3 style=\"margin:0\"><button class=\"faq-q\" type=\"button\">Can I distribute in multiple languages?<span class=\"icon\" aria-hidden=\"true\"></span></button></h3>\n          <div class=\"faq-a\"><div class=\"faq-a-inner prose\" style=\"font-size:var(--step-0)\">PressCosmos supports 24 languages including Arabic, Hebrew and Hindi in right-to-left and complex scripts. Translation is handled by specialist PR translators, not generic engines, and each language variant gets its own indexable page.</div></div>\n        </div><div class=\"faq-item\">\n          <h3 style=\"margin:0\"><button class=\"faq-q\" type=\"button\">Is there a free option?<span class=\"icon\" aria-hidden=\"true\"></span></button></h3>\n          <div class=\"faq-a\"><div class=\"faq-a-inner prose\" style=\"font-size:var(--step-0)\">We offer a free review and a limited free tier for qualifying non-profits, student projects and public-interest announcements. Paid plans start at $149 per release with no subscription required.</div></div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"section\">\n  <div class=\"wrap\">\n    <div class=\"cta-band\" data-reveal>\n      <p class=\"eyebrow\" style=\"justify-content:center;display:inline-flex\">Get started</p>\n      <h2 style=\"margin-top:1rem\">Put your next announcement in front of the people who act on it.</h2>\n      <p class=\"lede mx-auto\" style=\"margin-top:1rem;max-width:60ch\">Launch in under an hour. Editorial review, distribution, monitoring and AI visibility in one place.</p>\n      <div class=\"hero-actions\" style=\"justify-content:center\">\n        <a class=\"btn btn-lg\" href=\"submit.html\">Submit a press release</a>\n        <a class=\"btn btn-ghost btn-lg\" href=\"pricing.html\">See pricing</a>\n      </div>\n      <p class=\"mono faint mt-3\">No subscription required · Cancel anytime · Human editorial review on every release</p>\n    </div>\n  </div>\n</section>",
  "type": "website",
  "priority": 1,
  "changefreq": "daily"
}
