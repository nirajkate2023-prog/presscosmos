# Dependencies (the build has none, but keep the repo clean anyway)
node_modules/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Logs and local scratch
*.log
.tmp/

# Deployment artefacts — regenerate with tools/make-deploy.ps1
build/
*.zip

